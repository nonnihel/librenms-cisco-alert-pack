# LibreNMS URL án skástriks í lokin
LIBRENMS_URL=https://librenms.example.is

# API token: Global Settings / API Access
LIBRENMS_TOKEN=CHANGE_ME

# ÖRYGGISSTILLING: true = installer setur allar Averna Cisco reglur Disabled.
# Hafðu þetta true þar til hver regla hefur verið prófuð í þínu LibreNMS umhverfi.
INSTALL_DISABLED=true

# Valkostur A: nota operation sem er þegar til
# Finndu ID í Alerts -> Alert Operations eða með bin/list-rules.
ALERT_OPERATION_ID=

# Valkostur B: ef ALERT_OPERATION_ID er tómt býr installer til eina
# sameiginlega operation út frá þessum transport targets.
# Dæmi: 3,g2  (transport ID 3 og transport group ID g2)
TRANSPORT_TARGETS=

# Heiti á operation sem verður stofnuð í gegnum fyrstu reglu.
OPERATION_NAME=Averna Cisco - Network Operations

# Tímar
OPERATION_START_SECONDS=0
OPERATION_REPEAT_SECONDS=1800

# TLS sannprófun. Hafðu true nema private CA sé ekki komið inn á serverinn.
VERIFY_TLS=true

# Prefix tryggir að pakkinn rekist ekki á eldri reglur.
RULE_PREFIX=Averna Cisco -
